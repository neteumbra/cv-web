---
import Layout from '../layouts/Layout.astro';
---
<Layout title="cv-web — Instrucciones para IA">
  <div class="container">
    <header class="page-head">
      <h1 data-i18n="ai.title">Instrucciones para IA</h1>
      <p class="lead" data-i18n="ai.desc">
        ¿Tienes tu CV en Word, PDF, LinkedIn o en texto? Copia este prompt y pégaselo a tu IA favorita
        junto con tu CV: te lo devolverá en el formato exacto que este editor entiende.
      </p>
    </header>

    <ol class="steps-row">
      <li data-i18n="ai.step.1">Copia el prompt con el botón de abajo.</li>
      <li data-i18n="ai.step.2">Pégalo en tu IA junto con tu CV actual.</li>
      <li data-i18n="ai.step.3">Copia el resultado y pégalo en el editor.</li>
    </ol>

    <section class="card">
      <div class="card-head">
        <span class="card-title" data-i18n="ai.prompt.label">Prompt</span>
        <button id="copy-prompt" class="btn btn-primary" data-i18n="ai.copy">Copiar prompt</button>
      </div>
      <pre id="prompt" class="prompt" data-i18n="ai.prompt"></pre>
    </section>
  </div>

  <script>
    import { readLang, t } from '../i18n/lang';
    import { onLang } from '../lib/events';
    import { toast } from '../lib/toast';

    const btn = document.getElementById('copy-prompt') as HTMLButtonElement | null;
    let timer: number | undefined;

    const label = () => t('ai.copy', readLang());

    const done = () => {
      if (!btn) return;
      btn.classList.add('is-done');
      btn.textContent = t('ai.copied', readLang());
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.classList.remove('is-done');
        btn.textContent = label();
      }, 1800);
    };

    btn?.addEventListener('click', async () => {
      const text = document.getElementById('prompt')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        done();
      } catch {
        // Fallback: seleccionar el texto si el portapapeles no está disponible
        const el = document.getElementById('prompt');
        if (el) {
          const range = document.createRange();
          range.selectNodeContents(el);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        toast(t('ai.copy.blocked', readLang()), 'error');
      }
    });

    // Si cambia el idioma mientras el botón está en estado "copiado", se revalida
    onLang(() => {
      if (btn && !btn.classList.contains('is-done')) btn.textContent = label();
    });
  </script>
</Layout>
