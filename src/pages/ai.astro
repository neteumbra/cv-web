---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/server';
---
<Layout titleKey="meta.title.ai">
  <div class="container">
    <header class="page-head">
      <h1 data-i18n="ai.title">{t('ai.title')}</h1>
      <p class="lead" data-i18n="ai.desc">{t('ai.desc')}</p>
    </header>

    <ol class="steps-row">
      <li data-i18n="ai.step.1">{t('ai.step.1')}</li>
      <li data-i18n="ai.step.2">{t('ai.step.2')}</li>
      <li data-i18n="ai.step.3">{t('ai.step.3')}</li>
    </ol>

    <section class="card">
      <div class="card-head">
        <span class="card-title" data-i18n="ai.prompt.label">{t('ai.prompt.label')}</span>
        <button id="copy-prompt" class="btn btn-primary" data-i18n="ai.copy">{t('ai.copy')}</button>
      </div>
      <pre id="prompt" class="prompt" data-i18n="ai.prompt">{t('ai.prompt')}</pre>
    </section>
  </div>

  <script>
    import { readLang, t } from '../i18n/lang';
    import { onLang } from '../lib/events';
    import { toast } from '../lib/toast';

    const btn = document.getElementById('copy-prompt') as HTMLButtonElement | null;
    let timer: number | undefined;

    const label = () => t('ai.copy', readLang());

    const done = () => {
      if (!btn) return;
      btn.classList.add('is-done');
      btn.textContent = t('ai.copied', readLang());
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.classList.remove('is-done');
        btn.textContent = label();
      }, 1800);
    };

    btn?.addEventListener('click', async () => {
      const text = document.getElementById('prompt')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        done();
      } catch {
        // Fallback: seleccionar el texto si el portapapeles no está disponible
        const el = document.getElementById('prompt');
        if (el) {
          const range = document.createRange();
          range.selectNodeContents(el);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        toast(t('ai.copy.blocked', readLang()), 'error');
      }
    });

    // Si cambia el idioma mientras el botón está en estado "copiado", se revalida
    onLang(() => {
      if (btn && !btn.classList.contains('is-done')) btn.textContent = label();
    });
  </script>
</Layout>
