---
import Layout from '../layouts/Layout.astro';
import FormatDocEs from '../../docs/formato-cv.md';
import FormatDocEn from '../../docs/formato-cv.en.md';

const RAW_ES = 'https://github.com/neteumbra/cv-web/blob/main/docs/formato-cv.md';
const RAW_EN = 'https://github.com/neteumbra/cv-web/blob/main/docs/formato-cv.en.md';
---
<Layout title="cv-web — Docs">
  <div class="container">
    <header class="page-head">
      <h1 data-i18n="docs.title">Docs</h1>
      <p class="lead" data-i18n="docs.lead">
        Especificación del formato Markdown que entiende el editor. La misma fuente se mantiene en
        docs/formato-cv.md del repositorio.
      </p>
      <p class="doc-source">
        <a
          href={RAW_ES}
          data-raw-es={RAW_ES}
          data-raw-en={RAW_EN}
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="docs.raw"
        >Ver el archivo en GitHub ↗</a>
      </p>
    </header>

    {/* Ambos idiomas están en el DOM; sólo uno es visible (ver script) */}
    <article class="prose" data-doc="es">
      <FormatDocEs />
    </article>
    <article class="prose" data-doc="en" hidden>
      <FormatDocEn />
    </article>
  </div>

  <script>
    import { readLang } from '../i18n/lang';
    import { onLang } from '../lib/events';

    const raw = document.querySelector<HTMLAnchorElement>('.doc-source a');

    // Los dos documentos comparten slugs de encabezado: sólo el visible debe
    // conservarlos para que no haya ids duplicados (HTML válido + anclas).
    const syncIds = (root: HTMLElement, visible: boolean) => {
      root.querySelectorAll<HTMLElement>('[id]').forEach((el) => {
        if (visible) {
          if (el.dataset.origId) {
            el.id = el.dataset.origId;
            delete el.dataset.origId;
          }
        } else if (el.id) {
          el.dataset.origId = el.id;
          el.id = '';
        }
      });
    };

    const apply = (lang: string) => {
      const active = lang === 'en' ? 'en' : 'es';
      document.querySelectorAll<HTMLElement>('[data-doc]').forEach((el) => {
        const visible = el.dataset.doc === active;
        el.hidden = !visible;
        syncIds(el, visible);
      });
      if (raw) raw.href = raw.dataset[active === 'en' ? 'rawEn' : 'rawEs'] ?? raw.href;
    };

    apply(readLang());
    onLang((lang) => apply(lang));
  </script>
</Layout>

<style>
  .doc-source { margin: 14px 0 0; }
  .doc-source a {
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .doc-source a:hover { color: var(--accent-2); border-bottom-color: var(--accent-2); }
</style>
