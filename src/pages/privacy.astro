---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/server';

const base = import.meta.env.BASE_URL;
---
<Layout titleKey="meta.title.privacy">
  <div class="container">
    <header class="page-head">
      <h1 data-i18n="privacy.title">{t('privacy.title')}</h1>
      <p class="lead" data-i18n="privacy.lead">{t('privacy.lead')}</p>
    </header>

    <article class="prose">
      <h2 data-i18n="privacy.q1">{t('privacy.q1')}</h2>
      <p data-i18n="privacy.a1">{t('privacy.a1')}</p>
      <p data-i18n="privacy.a1b">{t('privacy.a1b')}</p>

      <h2 data-i18n="privacy.q2">{t('privacy.q2')}</h2>
      <p data-i18n="privacy.a2">{t('privacy.a2')}</p>

      <h2 data-i18n="privacy.q3">{t('privacy.q3')}</h2>
      <p data-i18n="privacy.a3">{t('privacy.a3')}</p>
      <p data-i18n="privacy.a3b">{t('privacy.a3b')}</p>

      <h2 data-i18n="privacy.q4">{t('privacy.q4')}</h2>
      <ul>
        <li data-i18n="privacy.a4.1">{t('privacy.a4.1')}</li>
      </ul>

      <h2 data-i18n="privacy.q5">{t('privacy.q5')}</h2>
      <p data-i18n="privacy.a5">{t('privacy.a5')}</p>

      <aside class="callout">
        <h2 data-i18n="privacy.donate.title">{t('privacy.donate.title')}</h2>
        <p data-i18n="privacy.donate.body">{t('privacy.donate.body')}</p>
        <a
          class="btn btn-primary"
          href="https://ko-fi.com/neteumbra"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            class="kofi-ico"
            src={`${base}/img/kofi-symbol.svg`}
            alt=""
            aria-hidden="true"
            width="20"
            height="16"
          />
          <span data-i18n="donate.kofi">{t('donate.kofi')}</span>
        </a>
      </aside>
    </article>
  </div>
</Layout>

<style>
  .callout {
    margin-top: 30px;
    padding: 18px 20px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
  }
  /* Gana a .prose h2 (misma página, mayor especificidad) */
  .prose .callout h2 {
    margin: 0 0 8px;
    padding-top: 0;
    border-top: 0;
    font-size: 17px;
  }
  .prose .callout p { margin: 0 0 14px; }
</style>
