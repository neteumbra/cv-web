---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="cv-web — Tu CV en Markdown con PDF al instante">
  <div class="hero-page">
    <section class="hero">
      <span class="badge">100% open source · GPL-3.0</span>
      <h1 data-i18n="landing.hero.title">Tu CV en Markdown, con PDF al instante</h1>
      <p class="lead" data-i18n="landing.hero.sub">
        Escribe a la izquierda y mira el PDF renderizarse a la derecha. Todo en tu navegador:
        sin servidores, sin cuentas y sin que nada salga de tu equipo.
      </p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href={`${base}/editor/`} data-i18n="landing.cta">Abrir el editor</a>
        <a class="btn btn-lg" href={`${base}/ai/`} data-i18n="landing.cta.ai">
          ¿Tienes un CV antiguo? Pídele a una IA que lo convierta
        </a>
      </div>

      {/* Mock decorativo del editor. La clase `play` arranca la secuencia
          "escribe → renderiza"; sin ella (reduced-motion o sin JS) se ve
          completo y estático. */}
      <div class="mock play" aria-hidden="true">
        <div class="mock-bar">
          <span></span><span></span><span></span>
          <em>cv.md</em>
        </div>
        <div class="mock-body">
          <div class="mock-code">
            <span class="ln" style="--i:0" data-i18n="landing.mock.name"># Nombre</span>
            <span class="ln" style="--i:1" data-i18n="landing.mock.title">- title: Diseñador de producto</span>
            <span class="ln" style="--i:2" data-i18n="landing.mock.email">- Email: correo@ejemplo.com</span>
            <span class="ln" style="--i:3"></span>
            <span class="ln" style="--i:4" data-i18n="landing.mock.exp">## EXPERIENCIA</span>
            <span class="ln" style="--i:5" data-i18n="landing.mock.company">### Empresa | Ciudad</span>
            <span class="ln" style="--i:6" data-i18n="landing.mock.role">#### Rol | 2020 - Presente</span>
            <span class="ln" style="--i:7" data-i18n="landing.mock.win1">- Logro 1</span>
            <span class="ln" style="--i:8" data-i18n="landing.mock.win2">- Logro 2</span>
          </div>
          <div class="mock-page">
            <div class="mock-sheet">
              <b data-i18n="landing.mock.sheetName">Nombre</b>
              <i></i>
              <i class="short"></i>
              <u data-i18n="landing.mock.sheetExp">EXPERIENCIA</u>
              <i></i>
              <i></i>
              <i class="short"></i>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Bucle de la animación del mock: reinicia la secuencia cada 4,8 s.
  // Con `prefers-reduced-motion` se detiene y se deja el mock completo.
  const mock = document.querySelector<HTMLElement>('.mock');
  if (mock) {
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;
    const play = () => {
      mock.classList.remove('play');
      void mock.offsetWidth; // reflow: fuerza el reinicio de las animaciones
      mock.classList.add('play');
    };
    const sync = () => {
      window.clearInterval(timer);
      if (mq.matches) {
        mock.classList.remove('play');
        return;
      }
      play();
      timer = window.setInterval(play, 4800);
    };
    mq.addEventListener('change', sync);
    sync();
  }
</script>
