---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/server';
const base = import.meta.env.BASE_URL;
---
<Layout titleKey="meta.title.landing">
  <div class="hero-page">
    <section class="hero">
      <span class="badge" data-i18n="landing.badge">{t('landing.badge')}</span>
      <h1 data-i18n="landing.hero.title">{t('landing.hero.title')}</h1>
      <p class="lead" data-i18n="landing.hero.sub">{t('landing.hero.sub')}</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href={`${base}/editor/`} data-i18n="landing.cta">{t('landing.cta')}</a>
        <a class="btn btn-lg" href={`${base}/ai/`} data-i18n="landing.cta.ai">{t('landing.cta.ai')}</a>
      </div>

      {/* Mock decorativo del editor. La clase `play` arranca la secuencia
          "escribe → renderiza"; sin ella (reduced-motion o sin JS) se ve
          completo y estático. */}
      <div class="mock play" aria-hidden="true">
        <div class="mock-bar">
          <span></span><span></span><span></span>
          <em>cv.md</em>
        </div>
        <div class="mock-body">
          <div class="mock-code">
            <span class="ln" style="--i:0" data-i18n="landing.mock.name">{t('landing.mock.name')}</span>
            <span class="ln" style="--i:1" data-i18n="landing.mock.title">{t('landing.mock.title')}</span>
            <span class="ln" style="--i:2" data-i18n="landing.mock.email">{t('landing.mock.email')}</span>
            <span class="ln" style="--i:3"></span>
            <span class="ln" style="--i:4" data-i18n="landing.mock.exp">{t('landing.mock.exp')}</span>
            <span class="ln" style="--i:5" data-i18n="landing.mock.company">{t('landing.mock.company')}</span>
            <span class="ln" style="--i:6" data-i18n="landing.mock.role">{t('landing.mock.role')}</span>
            <span class="ln" style="--i:7" data-i18n="landing.mock.win1">{t('landing.mock.win1')}</span>
            <span class="ln" style="--i:8" data-i18n="landing.mock.win2">{t('landing.mock.win2')}</span>
          </div>
          <div class="mock-page">
            <div class="mock-sheet">
              <b data-i18n="landing.mock.sheetName">{t('landing.mock.sheetName')}</b>
              <i></i>
              <i class="short"></i>
              <u data-i18n="landing.mock.sheetExp">{t('landing.mock.sheetExp')}</u>
              <i></i>
              <i></i>
              <i class="short"></i>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Bucle de la animación del mock: reinicia la secuencia cada 4,8 s.
  // Con `prefers-reduced-motion` se detiene y se deja el mock completo.
  const mock = document.querySelector<HTMLElement>('.mock');
  if (mock) {
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;
    const play = () => {
      mock.classList.remove('play');
      void mock.offsetWidth; // reflow: fuerza el reinicio de las animaciones
      mock.classList.add('play');
    };
    const sync = () => {
      window.clearInterval(timer);
      if (mq.matches) {
        mock.classList.remove('play');
        return;
      }
      play();
      timer = window.setInterval(play, 4800);
    };
    mq.addEventListener('change', sync);
    sync();
  }
</script>
