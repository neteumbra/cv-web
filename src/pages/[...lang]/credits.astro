---
import Layout from '../../layouts/Layout.astro';
import DonateButton from '../../components/DonateButton.astro';
import { t } from '../../i18n/server';
import { staticLangPaths } from '../../i18n/routes';
import { type Lang } from '../../i18n/dict';

export const getStaticPaths = () => staticLangPaths();
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Layout lang={lang} titleKey="meta.title.credits" descKey="meta.desc.credits">
  <div class="container">
    <header class="page-head">
      <h1>{t('credits.title', lang)}</h1>
      <p class="lead">{t('credits.lead', lang)}</p>
    </header>

    <section class="card">
      <div class="card-head">
        <span class="card-title">{t('credits.own.label', lang)}</span>
      </div>
      <p>{t('credits.own.body', lang)}</p>
      <div class="card-actions">
        <a class="btn" href="https://github.com/neteumbra/cv-web" target="_blank" rel="noopener noreferrer">
          {t('credits.own.repo', lang)}
        </a>
      </div>
    </section>

    {/* La mención del proyecto original es OBLIGATORIA por la licencia
        (regla de AGENTS.md): no se puede eliminar ni reformular sin más. */}
    <section class="card">
      <div class="card-head">
        <span class="card-title">{t('credits.original.label', lang)}</span>
      </div>
      <p>
        {t('credits.body.before', lang)}<a href="https://github.com/xthecapx/cv-generator" target="_blank" rel="noopener noreferrer">xthecapx/cv-generator</a>{t('credits.body.mid', lang)}<a href="https://github.com/xthecapx" target="_blank" rel="noopener noreferrer">(xthecapx)</a>{t('credits.body.after', lang)}
      </p>
      <div class="card-actions">
        <a class="btn" href="https://github.com/xthecapx/cv-generator" target="_blank" rel="noopener noreferrer">
          {t('credits.repo', lang)}
        </a>
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <span class="card-title">{t('credits.license.label', lang)}</span>
      </div>
      <p>{t('credits.license', lang)}</p>
    </section>

    {/* Tarjeta de soporte: misma anatomía que las demás, con el filete de
        acento a la izquierda para que se lea como "extra", no como contenido. */}
    <section class="card card-support">
      <div class="card-head">
        <span class="card-title">{t('credits.support.label', lang)}</span>
      </div>
      <p>{t('credits.support.body', lang)}</p>
      <div class="card-actions">
        <DonateButton lang={lang} />
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Filete de acento en la tarjeta de soporte (se suma a .card) */
  .card-support {
    border-left: 3px solid var(--accent);
  }
</style>
