---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/server';
import { staticLangPaths } from '../../i18n/routes';
import { type Lang } from '../../i18n/dict';

export const getStaticPaths = () => staticLangPaths();
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Layout lang={lang} titleKey="meta.title.ai" descKey="meta.desc.ai">
  <div class="container">
    <header class="page-head">
      <h1>{t('ai.title', lang)}</h1>
      <p class="lead">{t('ai.desc', lang)}</p>
    </header>

    <ol class="steps-row">
      <li>{t('ai.step.1', lang)}</li>
      <li>{t('ai.step.2', lang)}</li>
      <li>{t('ai.step.3', lang)}</li>
    </ol>

    <section class="card">
      <div class="card-head">
        <span class="card-title">{t('ai.prompt.label', lang)}</span>
        {/* Los textos del feedback viajan en data-*: el script no necesita
            el diccionario, sólo leer el atributo del propio idioma. */}
        <button
          id="copy-prompt"
          class="btn btn-primary"
          data-label={t('ai.copy', lang)}
          data-done={t('ai.copied', lang)}
          data-blocked={t('ai.copy.blocked', lang)}
        >{t('ai.copy', lang)}</button>
      </div>
      <pre id="prompt" class="prompt">{t('ai.prompt', lang)}</pre>
    </section>
  </div>

  <script>
    import { toast } from '../../lib/toast';

    const btn = document.getElementById('copy-prompt') as HTMLButtonElement | null;
    const label = btn?.dataset.label ?? '';
    const done = btn?.dataset.done ?? '';
    const blocked = btn?.dataset.blocked ?? '';
    let timer: number | undefined;

    const finish = () => {
      if (!btn) return;
      btn.classList.add('is-done');
      btn.textContent = done;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.classList.remove('is-done');
        btn.textContent = label;
      }, 1800);
    };

    btn?.addEventListener('click', async () => {
      const text = document.getElementById('prompt')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        finish();
      } catch {
        // Fallback: seleccionar el texto si el portapapeles no está disponible
        const el = document.getElementById('prompt');
        if (el) {
          const range = document.createRange();
          range.selectNodeContents(el);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        toast(blocked, 'error');
      }
    });
  </script>
</Layout>
