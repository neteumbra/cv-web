---
import { t } from '../i18n/server';
const base = import.meta.env.BASE_URL;
const norm = (s: string) => s.replace(/\/+$/, '');
const current = norm(Astro.url.pathname);
const root = norm(base);
const isActive = (page: string) => current === `${root}/${page}`;
---
<nav class="navbar">
  <a class="brand" href={`${base}/`} aria-label="cv-web">
    <img src={`${base}/favicon.svg`} alt="" width="20" height="20" />
    <span>cv-web</span>
  </a>

  <ul class="links" id="nav-links">
    <li>
      <a
        href={`${base}/editor/`}
        data-i18n="nav.editor"
        aria-current={isActive('editor') ? 'page' : undefined}>{t('nav.editor')}</a>
    </li>
    <li>
      <a
        href={`${base}/ai/`}
        data-i18n="nav.ai"
        aria-current={isActive('ai') ? 'page' : undefined}>{t('nav.ai')}</a>
    </li>
    <li>
      <a
        href={`${base}/credits/`}
        data-i18n="nav.credits"
        aria-current={isActive('credits') ? 'page' : undefined}>{t('nav.credits')}</a>
    </li>
  </ul>

  {/* Grupo derecho: control segmentado [Docs][idioma][menú móvil] */}
  <div class="nav-actions" role="group" aria-label={t('nav.actions')} data-i18n-aria="nav.actions">
    <a
      class="seg"
      href={`${base}/docs/`}
      data-i18n="nav.docs"
      aria-current={isActive('docs') ? 'page' : undefined}>{t('nav.docs')}</a>

    <button
      id="lang-toggle"
      class="seg"
      type="button"
      aria-label={t('nav.lang')}
      data-i18n-aria="nav.lang"
    >
      <svg class="ico" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9.25" />
        <path d="M2.75 12h18.5" />
        <path d="M12 2.75a14.5 14.5 0 0 1 3.6 9.25 14.5 14.5 0 0 1-3.6 9.25 14.5 14.5 0 0 1-3.6-9.25A14.5 14.5 0 0 1 12 2.75z" />
      </svg>
      <span id="lang-label">ES</span>
    </button>

    <button
      class="seg nav-toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label={t('nav.menu')}
      data-i18n-aria="nav.menu"
    >
      <svg class="ico icon-open" width="16" height="16" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="ico icon-close" width="16" height="16" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  const setOpen = (open: boolean) => {
    links?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => {
    setOpen(!links?.classList.contains('is-open'));
  });

  // Al elegir un enlace se pliega el acordeón
  links?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement)?.closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
