---
import { t } from '../i18n/server';
import { type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const page = (p: string) => (lang === 'en' ? `${base}/en${p}` : `${base}${p}`);
---
<footer class="footer">
  <div class="row">
    <a href="https://github.com/neteumbra/cv-web">{t('footer.repo', lang)}</a>
    <a href={page('/credits/')}>{t('footer.credits', lang)}</a>
    <span class="spacer"></span>
    <a
      class="privacy"
      href={page('/privacy/')}
      title={t('footer.privacy.hint', lang)}
    >{t('footer.privacy', lang)}</a>
  </div>
</footer>
