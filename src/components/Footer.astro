---
import { t } from '../i18n/server';
const base = import.meta.env.BASE_URL;
---
<footer class="footer">
  <div class="row">
    <a href="https://github.com/neteumbra/cv-web" data-i18n="footer.repo">{t('footer.repo')}</a>
    <a href={`${base}/credits/`} data-i18n="footer.credits">{t('footer.credits')}</a>
    <span class="spacer"></span>
    <a
      class="privacy"
      href={`${base}/privacy/`}
      data-i18n="footer.privacy"
      data-i18n-title="footer.privacy.hint"
      title={t('footer.privacy.hint')}
    >{t('footer.privacy')}</a>
  </div>
</footer>
