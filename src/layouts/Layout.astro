---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
// CSS global, extraído de este mismo fichero (Ronda 5). El orden de los
// imports es el orden de la cascada original: no reordenar a la ligera.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/landing.css';
import '../styles/editor.css';
import '../styles/content.css';
import '../styles/responsive.css';
interface Props {
  title?: string;
}
const { title = 'cv-web — Editor de CV en Markdown' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Editor de CV en markdown con previsualización PDF en vivo. Todo en tu navegador, open source." />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main class="page">
      <slot />
    </main>
    <Footer />

    <div id="toast" class="toast" role="status" aria-live="polite" aria-atomic="true"></div>

    <script>
      // El i18n y los toasts viven en módulos TS (Ronda 6); aquí sólo se arrancan.
      import { initI18n } from '../i18n/lang';
      import { initToasts } from '../lib/toast';

      initI18n();
      initToasts();
    </script>
  </body>
</html>

