---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title?: string;
}
const { title = 'cv-web — Editor de CV en Markdown' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Editor de CV en markdown con previsualización PDF en vivo. Todo en tu navegador, open source." />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main class="page">
      <slot />
    </main>
    <Footer />

    <script>
      import { dict } from '../i18n/dict';
      type Lang = 'es' | 'en';
      const KEY = 'cv-web:lang';
      const getLang = (): Lang => (localStorage.getItem(KEY) === 'en' ? 'en' : 'es');

      const apply = (lang: Lang) => {
        document.documentElement.lang = lang;
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const entry = dict[el.dataset.i18n ?? ''];
          if (entry && entry[lang]) el.textContent = entry[lang];
        });
        const btn = document.getElementById('lang-toggle');
        if (btn) btn.textContent = lang === 'es' ? '🌐 ES' : '🌐 EN';
        localStorage.setItem(KEY, lang);
        window.dispatchEvent(new CustomEvent('cv-lang', { detail: lang }));
      };

      apply(getLang());
      document.getElementById('lang-toggle')?.addEventListener('click', () => {
        apply(getLang() === 'es' ? 'en' : 'es');
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0d1117;
    --panel: #161b22;
    --border: #30363d;
    --text: #e6edf3;
    --muted: #8b949e;
    --accent: #2f81f7;
    --green: #238636;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1, h2, h3 { line-height: 1.25; }

  /* Navbar */
  .navbar {
    flex: 0 0 auto;
    min-height: 49px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px 16px;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .navbar .brand { font-weight: 700; font-size: 16px; color: var(--text); letter-spacing: 0.4px; }
  .navbar .links { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  .navbar .links a { display: block; padding: 6px 10px; border-radius: 6px; color: var(--text); font-size: 13px; }
  .navbar .links a:hover { background: #21262d; text-decoration: none; }
  #lang-toggle {
    margin-left: auto;
    background: #21262d;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 10px;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
  }
  #lang-toggle:hover { border-color: var(--muted); }

  /* Scrollable content area */
  .page { flex: 1 1 auto; min-height: 0; overflow-y: auto; }

  /* Footer */
  .footer {
    flex: 0 0 auto;
    background: var(--panel);
    border-top: 1px solid var(--border);
    padding: 14px 16px;
    font-size: 13px;
    color: var(--muted);
  }
  .footer .row { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  .footer .os { color: var(--text); font-weight: 600; }
  .footer a { color: var(--muted); }
  .footer a:hover { color: var(--accent); }

  /* Editor */
  .editor-wrap { height: 100%; display: flex; flex-direction: column; }
  .split { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; }
  .split .cell { min-width: 0; min-height: 0; overflow: hidden; display: flex; }
  .split .cell:first-child { border-right: 1px solid var(--border); }

  /* Editor toolbar (React) */
  .toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .toolbar .brand { margin-right: 4px; font-weight: 600; }
  .toolbar .btn,
  .toolbar button {
    background: #21262d;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 5px 10px;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .toolbar button:hover:not(:disabled),
  .toolbar .btn:hover { background: #30363d; border-color: var(--muted); }
  .toolbar button:disabled { opacity: 0.5; cursor: not-allowed; }
  .toolbar .status { margin-left: auto; color: var(--muted); font-size: 12px; }

  /* Content pages: landing, ai, credits */
  .container { max-width: 880px; margin: 0 auto; padding: 44px 24px 64px; }
  .hero { text-align: center; padding: 28px 0 8px; }
  .hero h1 { font-size: 34px; margin: 0 0 14px; }
  .hero p { font-size: 17px; color: var(--muted); max-width: 700px; margin: 0 auto 24px; }
  .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary, .btn-ghost {
    display: inline-block;
    padding: 11px 20px;
    border-radius: 8px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .btn-primary { background: var(--green); color: #fff; }
  .btn-primary:hover { background: #2ea043; text-decoration: none; }
  .btn-ghost { background: #21262d; color: var(--text); border-color: var(--border); }
  .btn-ghost:hover { background: #30363d; text-decoration: none; }
  .section { margin-top: 44px; }
  .section h2 { font-size: 22px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  .section p { color: #c9d1d9; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
    padding: 0;
    margin: 16px 0 0;
    list-style: none;
  }
  .grid li { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
  .steps { padding-left: 20px; color: #c9d1d9; }
  .steps li { margin: 8px 0; }
  .badge {
    display: inline-block;
    background: rgba(31, 111, 235, 0.2);
    color: var(--accent);
    border: 1px solid rgba(31, 111, 235, 0.4);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
  }
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin-top: 16px; }
  pre.prompt {
    background: #010409;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px;
    overflow: auto;
    white-space: pre-wrap;
    font-size: 13px;
    line-height: 1.5;
    color: #c9d1d9;
    max-height: 54vh;
  }

  @media (max-width: 800px) {
    .split { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }
    .split .cell:first-child { border-right: none; border-bottom: 1px solid var(--border); }
  }
</style>
